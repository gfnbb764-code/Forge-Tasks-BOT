# ============================================================
# COLORS
# ============================================================

COLOR_MAIN = discord.Color.blurple()
COLOR_SUCCESS = discord.Color.green()
COLOR_WARNING = discord.Color.orange()
COLOR_ERROR = discord.Color.red()
COLOR_GOLD = discord.Color.gold()
COLOR_LEVEL = discord.Color.purple()


# ============================================================
# TIME
# ============================================================

def now():

    return datetime.now(
        timezone.utc
    )


# ============================================================
# BASE EMBED
# ============================================================

def create_embed(
    title,
    description="",
    color=COLOR_MAIN
):

    embed = discord.Embed(

        title=title,

        description=description,

        color=color,

        timestamp=now()

    )

    embed.set_footer(
        text="Task Bot"
    )

    return embed


# ============================================================
# TASK EMOJI
# ============================================================

def task_emoji(
    task_type
):

    emojis = {

        "messages": "💬",

        "images": "🖼️",

        "invites": "📨",

        "afk": "💤",

        "level": "⭐",

        "nickname": "✏️",

    }

    return emojis.get(
        task_type,
        "📋"
    )


# ============================================================
# PERIOD EMOJI
# ============================================================

def period_emoji(
    period
):

    emojis = {

        "daily": "☀️",

        "weekly": "📅",

        "monthly": "🌙",

    }

    return emojis.get(
        period,
        "📋"
    )


# ============================================================
# TASKS EMBED
# ============================================================

def tasks_embed(
    guild_id,
    user_id,
    currency_name,
    currency_symbol
):

    embed = create_embed(

        "📋 مهامك",

        (
            f"أنجز المهام واحصل على "
            f"**{currency_name} {currency_symbol}** 🪙"
        )

    )


    periods = [

        (
            "daily",
            "☀️ المهام اليومية"
        ),

        (
            "weekly",
            "📅 المهام الأسبوعية"
        ),

        (
            "monthly",
            "🌙 المهام الشهرية"
        ),

    ]


    for period, title in periods:

        tasks = get_task_display(

            guild_id,

            user_id,

            period

        )


        if not tasks:

            if period == "monthly":

                value = (
                    "لا توجد مهام شهرية حالياً."
                )

            else:

                value = (
                    "لا توجد مهام متاحة."
                )


        else:

            lines = []


            for task in tasks:

                emoji = task_emoji(
                    task.get(
                        "type",
                        ""
                    )
                )


                if task["completed"]:

                    status = "✅"

                else:

                    status = "⬜"


                lines.append(

                    f"{status} {emoji} "
                    f"**{task['name']}**\n"

                    f"└ {task['description']}\n"

                    f"└ {task['bar']} "
                    f"`{task['progress']}/{task['target']}`\n"

                    f"└ 🪙 **{task['reward']} "
                    f"{currency_name}**"

                )


            value = "\n\n".join(
                lines
            )


        embed.add_field(

            name=title,

            value=value,

            inline=False

        )


    embed.set_footer(

        text=(
            "Task Bot • أنجز المهام وارفع مستواك"
        )

    )


    return embed


# ============================================================
# PROFILE EMBED
# ============================================================

def profile_embed(
    member,
    user,
    currency_name,
    currency_symbol,
    current_xp,
    required_xp,
    percentage
):

    embed = create_embed(

        f"👤 {member.display_name}",

        "إحصائيات حسابك وتقدمك",

        COLOR_MAIN

    )


    embed.set_thumbnail(

        url=member.display_avatar.url

    )


    filled = int(
        percentage / 10
    )


    filled = max(
        0,
        min(
            filled,
            10
        )
    )


    bar = (

        "🟦" * filled +

        "⬜" * (
            10 - filled
        )

    )


    embed.add_field(

        name="🪙 الرصيد",

        value=(

            f"**{user['coins']}** "
            f"{currency_symbol}"

        ),

        inline=True

    )


    embed.add_field(

        name="⭐ المستوى",

        value=(

            f"**Level "
            f"{user['level']}**"

        ),

        inline=True

    )


    embed.add_field(

        name="✨ XP",

        value=(

            f"**{current_xp} / "
            f"{required_xp}**"

        ),

        inline=True

    )


    embed.add_field(

        name="📊 التقدم",

        value=(

            f"{bar}\n"
            f"**{percentage}%**"

        ),

        inline=False

    )


    embed.add_field(

        name="💬 الرسائل",

        value=str(
            user["messages"]
        ),

        inline=True

    )


    embed.add_field(

        name="🖼️ الصور",

        value=str(
            user["images"]
        ),

        inline=True

    )


    embed.add_field(

        name="📨 الدعوات",

        value=str(
            user["invites"]
        ),

        inline=True

    )


    embed.add_field(

        name="🎙️ وقت الصوت",

        value=format_seconds(
            user["voice_seconds"]
        ),

        inline=True

    )


    embed.add_field(

        name="💤 وقت AFK",

        value=format_seconds(
            user["afk_seconds"]
        ),

        inline=True

    )


    embed.add_field(

        name="🏅 العملة",

        value=currency_name,

        inline=True

    )


    return embed


