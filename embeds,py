def reminder_embed(
    tasks,
    currency_name,
    currency_symbol
):

    embed = create_embed(

        "🔔 تذكير بالمهام",

        (

            "عندك مهام لسا ما خلصتها! 👀\n"
            "لا تضيع المكافآت."

        ),

        COLOR_WARNING

    )


    lines = []


    for task in tasks:

        if task["completed"]:

            continue


        lines.append(

            f"⬜ **{task['name']}**\n"

            f"└ {task['bar']} "
            f"`{task['progress']}/{task['target']}`\n"

            f"└ 🪙 {task['reward']} "
            f"{currency_symbol}"

        )


    if not lines:

        embed.description = (
            "🎉 ما عندك مهام ناقصة!"
        )

    else:

        embed.add_field(

            name="📋 المهام المتبقية",

            value="\n\n".join(
                lines
            ),

            inline=False

        )


    return embed


# ============================================================
# FORMAT SECONDS
# ============================================================

def format_seconds(
    seconds
):

    seconds = max(
        0,
        int(seconds)
    )


    hours = seconds // 3600

    minutes = (
        seconds % 3600
    ) // 60

    remaining = (
        seconds % 60
    )


    if hours:

        return (
            f"{hours} ساعة "
            f"{minutes} دقيقة"
        )


    if minutes:

        return (
            f"{minutes} دقيقة "
            f"{remaining} ثانية"
        )


    return (
        f"{remaining} ثانية"
    )
